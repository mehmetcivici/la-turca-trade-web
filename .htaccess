# La Turca Trade — cPanel / Apache
Options -Indexes
DirectoryIndex index.html index.php
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS + www'suz alan adı
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Kök adres (/) → ana dil (/es/), kalıcı. Hedef sabit olduğu için CDN önbelleğinde güvenli.
  # Dil önerisi sayfalarda tarayıcı tarafında yapılır (LangSuggest). Accept-Language'e göre
  # sunucu yönlendirmesi YAPILMAZ: CDN tek dilin yönlendirmesini herkese dağıtabilir.
  # Google doğrulama robotu kök sayfayı (doğrulama etiketli) yönlendirmesiz görsün
  RewriteCond %{HTTP_USER_AGENT} !Google-Site-Verification [NC]
  RewriteRule ^$ /es/ [L,R=301,E=LTT_KOK:1]
</IfModule>

ErrorDocument 404 /404.html

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>

<IfModule mod_headers.c>
  # HTML ve sürüm dosyaları her istekte tazelik kontrolü yapsın (yeni sürümler CDN'de takılmasın)
  <FilesMatch "\.(html|txt|json|xml)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Kök yönlendirmesi CDN'de önbelleğe alınmasın (doğrulama robotu istisnası her seferinde çalışsın)
  Header always set Cache-Control "no-store, max-age=0" env=LTT_KOK
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
