{
  "name": "la-turca-trade-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync:catalogs": "node scripts/sync-catalogs.mjs",
    "prepare:assets": "node scripts/sync-catalogs.mjs && node --no-warnings scripts/make-map.mjs",
    "dev": "npm run prepare:assets && next dev",
