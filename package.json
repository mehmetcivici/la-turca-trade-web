    "start": "npx serve out",
    "build:cpanel": "bash scripts/build-cpanel.sh"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "15.5.3",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.13",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-shape": "^3.1.7",
    "@types/node": "22.18.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@types/topojson-client": "^3.1.5",
    "d3-geo": "^3.1.1",
    "d3-shape": "^3.2.0",
    "postcss": "8.5.6",
    "tailwindcss": "4.1.13",
    "topojson-client": "^3.1.0",
    "typescript": "5.9.2",
    "world-atlas": "^2.0.2"
  }
}
